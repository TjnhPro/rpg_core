{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "lib": [
      "ES2022"
    ],
    "types": [
      "node"
    ],
    "declaration": true,
    "outDir": "dist",
    "rootDir": "."
  },
  "include": [
    "src",
    "examples/*.ts"
  ]
}
